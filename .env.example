# GEMINI_API_KEY: Required for server-side WellAge AI assistant calls via @google/genai.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of the deployed application (injected automatically in AI Studio / Cloud Run).
APP_URL="http://localhost:3000"

# ELDERCARE_SESSION_SECRET: Secret key used to sign session tokens (set a strong random string in production).
ELDERCARE_SESSION_SECRET="change-me-in-production-32-chars-minimum"

# PORT: Server port (defaults to 3000).
PORT=3000

# Cloud SQL PostgreSQL Connection Variables (injected by AI Studio / Cloud Run)
SQL_HOST=""
SQL_PORT="5432"
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_SSL="false"
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# SMTP Email Configuration (Optional - Nodemailer uses these for real automated email alerts)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="your-email@example.com"
SMTP_PASS="your-app-password"
SMTP_FROM="WellAge <alerts@wellage.example.com>"
